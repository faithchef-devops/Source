{{!< default}}

<main class="gh-main">
    <section class="fc-home gh-container gh-outer">
        <div class="gh-inner">

            <h1 class="fc-date">{{date format="dddd MMM D"}}</h1>

            {{#get "posts"
                include="tags"
                limit="3"
                order="published_at asc"
                filter="published_at:>=now-24h+published_at:<now"
                as |today|
            }}

            <div class="fc-rail" aria-label="Today">
                <div class="fc-row">

                    {{!-- SLOT 1: morning --}}
                    {{#if today.[0]}}
                        {{#with today.[0]}}
                            <article class="fc-card">
                                <h3 class="slot-title">Morning Encouragement</h3>
                                <a class="fc-link" href="{{url}}">
                                    <div class="fc-media">
                                        {{#if feature_image}}
                                            <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                                        {{else}}
                                            {{> "components/fc-placeholder" slot="morning"}}
                                        {{/if}}
                                    </div>

                                    <div class="fc-body">
                                        <h2 class="fc-title">{{title}}</h2>
                                        {{#if excerpt}}
                                            <div class="fc-excerpt">{{excerpt}}</div>
                                        {{/if}}
                                    </div>
                                </a>
                            </article>
                        {{/with}}
                    {{else}}
                        <article class="fc-card">
                                <h3 class="slot-title">Morning Encouragement</h3>
                                <div class="fc-media">
                                    {{> "components/fc-placeholder" slot="morning"}}
                                </div>
                                <div class="fc-body unpublished">
                                   <h3 class="waiting">Your morning encouragement will be here when you wake up.</h3>
                                </div>
                  
                        </article>
                    {{/if}}

                    {{!-- SLOT 2: study --}}
                    {{#if today.[1]}}
                        {{#with today.[1]}}
                            <article class="fc-card">
                                <h3 class="slot-title">Lunchtime Study</h3>
                                <a class="fc-link" href="{{url}}">
                                    <div class="fc-media">
                                        {{#if feature_image}}
                                            <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                                        {{else}}
                                            {{> "components/fc-placeholder" slot="study"}}
                                        {{/if}}
                                    </div>

                                    <div class="fc-body">
                                        <h2 class="fc-title">{{title}}</h2>
                                        {{#if excerpt}}
                                            <div class="fc-excerpt">{{excerpt}}</div>
                                        {{/if}}
                                    </div>
                                </a>
                            </article>
                        {{/with}}
                    {{else}}
                        <article class="fc-card">
                                <h3 class="slot-title">Lunchtime Study</h3>
                                <div class="fc-media">
                                    {{> "components/fc-placeholder" slot="study"}}
                                </div>
                                <div class="fc-body unpublished">
                                    <h3 class="waiting">Your lunchtime bible study will be here after your difficult morning.</h3>
                                </div>
                          
                        </article>
                    {{/if}}

                    {{!-- SLOT 3: prayer --}}
                    {{#if today.[2]}}
                        {{#with today.[2]}}
                            <article class="fc-card">
                                <h3 class="slot-title">Evening Prayer</h3>
                                <a class="fc-link" href="{{url}}">
                                    <div class="fc-media">
                                        {{#if feature_image}}
                                            <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
                                        {{else}}
                                            {{> "components/fc-placeholder" slot="prayer"}}
                                        {{/if}}
                                    </div>

                                    <div class="fc-body">
                                        <h2 class="fc-title">{{title}}</h2>
                                        {{#if excerpt}}
                                            <div class="fc-excerpt">{{excerpt}}</div>
                                        {{/if}}
                                    </div>
                                </a>
                            </article>
                        {{/with}}
                    {{else}}
                        <article class="fc-card unpublished">
                            <h3 class="slot-title">Evening Prayer</h3>
                                <div class="fc-media">
                                    {{> "components/fc-placeholder" slot="prayer"}}
                                </div>
                                <div class="fc-body">
                                    <h3 class="waiting">Your evening prayer will be waiting for you right here when you check back in.</h3>
                                </div>
                        
                        </article>
                    {{/if}}

                </div>
            </div>

            {{/get}}

        </div>
    </section>
</main>
